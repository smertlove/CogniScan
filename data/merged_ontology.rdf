        <psy_diseases_project:SuffersFrom rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Гебефреническая_шизофрения"/>
        <psy_diseases_project:SuffersFrom rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Кататоническая_шизофрения"/>
