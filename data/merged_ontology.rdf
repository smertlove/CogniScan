    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Истерическое_расстройство_личности -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Истерическое_расстройство_личности">
