        <psy_diseases_project:SuffersFrom rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Параноидная_шизофрения"/>
        <mob_psycho_100:isOffensive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mob_psycho_100:isOffensive>
