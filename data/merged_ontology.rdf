    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Устойчивое_соматоформное_болевое_расстройство -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Устойчивое_соматоформное_болевое_расстройство">
        <rdf:type rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Соматоформные_расстройства"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Психогенная_боль_в_спине"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Психогенная_головная_боль"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Резкая_боль"/>
        <mob_psycho_100:hasDescription>Основной жалобой является устойчивая, резкая мучительная боль, которую нельзя полностью объяснить физиологическим нарушением или соматическим заболеванием и которая возникает в связи с эмоциональным конфликтом или психосоциальными проблемами, что позволяет рассматривать их как основную этиологическую причину. Результатом обычно является заметное усиление поддержки и внимания личностного или медицинского характера. Боль психогенной природы, возникающая в процессе депрессивного расстройства или шизофрении, не может быть отнесена к этой рубрике.

Психалгия

Психогенная:

боль в спине
головная боль
Соматоформное болевое расстройство</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F45.4</mob_psycho_100:hasMCBcode>
        <psy_diseases_project:hasSuicideRisk rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</psy_diseases_project:hasSuicideRisk>
    </owl:NamedIndividual>
    


