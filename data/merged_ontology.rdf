    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Транс -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Транс">
        <rdf:type rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Наименования_больных"/>
        <mob_psycho_100:isSynonym rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Транссексуал"/>
        <psy_diseases_project:SuffersFrom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Трансвестизм_двойной_роли"/>
        <psy_diseases_project:SuffersFrom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Транссексуализм"/>
        <mob_psycho_100:isOffensive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mob_psycho_100:isOffensive>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Транс_и_одержимость -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Транс_и_одержимость">
        <rdf:type rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Диссоциативные_[конверсионные]_расстройства"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Дезориентированность"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Деперсонализация"/>
        <mob_psycho_100:hasDescription>Расстройства, при которых имеет место временная потеря ощущения себя как личности и полная неосознанность окружающего. В эту рубрику включены только состояния транса, которые непроизвольны и нежелательны и возникают вне религиозных или культурно-приемлемых ситуаций.</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F44.3</mob_psycho_100:hasMCBcode>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Трансвестизм_двойной_роли -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Трансвестизм_двойной_роли">
        <rdf:type rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Расстройства_половой_идентификации"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Желание_насладиться_временным_участием_в_жизни_противоположного_пола"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Периодическое_ношение_одежды_противоположного_пола"/>
        <mob_psycho_100:hasDescription>Периодическое ношение одежды противоположного пола для того, чтобы насладиться временным участием в жизни противоположного пола, но без какого-либо желания изменить свой пол, в том числе и хирургическим путем, и без полового возбуждения, сопровождающего переодевание.

Расстройство половой идентификации в юности или зрелом возрасте не транссексуального типа

Исключен: фетишистский трансвестизм (F65.1)</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F64.1</mob_psycho_100:hasMCBcode>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Транссексуал -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Транссексуал">
        <rdf:type rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Наименования_больных"/>
        <mob_psycho_100:isSynonym rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Транс"/>
        <psy_diseases_project:SuffersFrom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Транссексуализм"/>
        <mob_psycho_100:isOffensive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mob_psycho_100:isOffensive>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Транссексуализм -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Транссексуализм">
        <rdf:type rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Расстройства_половой_идентификации"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Желание_восприниматься_окружающими_как_лицо_противоположного_пола"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Желание_жить_как_лицо_противоположного_пола"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Ощущение_дискомфорта_от_своего_анатомического_пола"/>
        <mob_psycho_100:hasDescription>Желание жить и восприниматься окружающими как лицо противоположного пола, обычно сопровождаемое ощущением дискомфорта от своего анатомического пола или чувством неуместности своей половой принадлежности. Желание подвергнуться хирургическому вмешательству или получить гормональное лечение с тем, чтобы достичь, насколько это возможно, соответствия предпочитаемому полу.</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F64.0</mob_psycho_100:hasMCBcode>
    </owl:NamedIndividual>
    


