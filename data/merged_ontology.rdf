    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Потеря_способности_двигать_конечностью -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Потеря_способности_двигать_конечностью">
        <rdf:type rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Физиологические_симптомы"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Припадок"/>
        <mob_psycho_100:hasDescription>Диссоциативные конвульсии могут имитировать эпилептический припадок, однако прикусывание языка, кровоподтеки, связанные с падением, и непроизвольное мочеиспускание редки. Сознание сохранено либо заменено состоянием ступора или транса.</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F44.5</mob_psycho_100:hasMCBcode>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Потеря_чувственного_восприятия -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Потеря_чувственного_восприятия">
        <rdf:type rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Физиологические_симптомы"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Потеря_эмоций -->

