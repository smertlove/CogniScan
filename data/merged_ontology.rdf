    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Комбинирование_вокализмов_и_множественных_моторных_тиков_[синдром_де_ла_Туретта]">
        <rdf:type rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Тики"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#вокализм"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#тик"/>
        <mob_psycho_100:hasDescription>Форма тиков, при которой имеются или имелись множественные моторные тики и один или несколько вокализмов, хотя нет необходимости, чтобы они возникали одновременно. Расстройство обычно усиливается в подростковом возрасте и имеет тенденцию сохраняться в зрелом возрасте.</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F95.2</mob_psycho_100:hasMCBcode>
        <psy_diseases_project:hasSuicideRisk rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</psy_diseases_project:hasSuicideRisk>
