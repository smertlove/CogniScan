    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Эсгибиционизм -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Эсгибиционизм">
        <rdf:type rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Расстройства_сексуального_предпочтения"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Мастурбация"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Отсутствие_намерения_вступить_в_близкий_контакт"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Показ_своих_половых_органов_посторонним_лицам"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Сексуальное_возбуждение"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Сексуальное_возбуждение_в_момент_показа_половых_органов"/>
        <mob_psycho_100:hasDescription>Повторная или устойчивая тенденция показывать свои половые органы посторонним лицам (обычно противоположного пола) или людям в общественных местах без намерения вступить в близкий контакт. Обычно, но не всегда отмечается сексуальное возбуждение в момент показа половых органов, и этот акт чаще всего сопровождается мастурбацией.</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F65.2</mob_psycho_100:hasMCBcode>
    </owl:NamedIndividual>
    


