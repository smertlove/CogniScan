        <psy_diseases_project:requiresHospitalisation rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</psy_diseases_project:requiresHospitalisation>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/alex/ontologies/2025/11/untitled-ontology-7#Циклотимия -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/alex/ontologies/2025/11/untitled-ontology-7#Циклотимия">
        <rdf:type rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Устойчивые_расстройства_настроения_[аффективные_расстройства]"/>
        <isSimilar rdf:resource="http://www.semanticweb.org/alex/ontologies/2025/11/untitled-ontology-7#Гипомания"/>
        <isSimilar rdf:resource="http://www.semanticweb.org/alex/ontologies/2025/11/untitled-ontology-7#Депрессивный_эпизод_средней_степени"/>
