    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Потливость">
        <rdf:type rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Физиологические_симптомы"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Преимущественно_навязчивые_мысли_или_размышления -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Преимущественно_навязчивые_мысли_или_размышления">
        <rdf:type rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Обсессивно-компульсивное_расстройство"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Навязчивые_мысли"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Тревожность"/>
        <mob_psycho_100:hasDescription>Они могут принимать форму идей, мысленных образов или побуждений к действию, которые почти всегда причиняют страдание пациенту. Иногда идеи являются незаконченными, бесконечно рассматриваемыми альтернативами, связанными с неспособностью принять обычное, но необходимое решение, касающееся повседневной жизни. Связь между навязчивыми размышлениями и депрессией является особенно тесной, поэтому диагнозу обсессивно-компульсивного расстройства следует отдать предпочтение лишь только в том случае, если навязчивые мысли возникают или удерживаются при отсутствии депрессивного эпизода.</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F42.0</mob_psycho_100:hasMCBcode>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Пренебрежение_к_социальным_обязанностям -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Пренебрежение_к_социальным_обязанностям">
        <rdf:type rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Социальные_симптомы"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Преувеличение_соматической_симптоматики_по_психологическим_причинам -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Преувеличение_соматической_симптоматики_по_психологическим_причинам">
        <rdf:type rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Другие_расстройства_личности_и_поведения_в_зрелом_возрасте"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Боли_в_теле"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Снижение_дееспособности"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Тревожность"/>
        <mob_psycho_100:hasDescription>Соматические симптомы, которые соответствуют и вызваны подтвержденным физическим нарушением, болезнью или снижением физических возможностей, становятся преувеличенными или затяжными вследствие психологического состояния пациента. Пациент обычно страдает от боли или снижения дееспособности и часто полностью поглощен своей тревогой (которая может быть оправданной) о возможности продолжения или прогрессирования боли и снижения дееспособности.

Компенсационный невроз</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F68.0</mob_psycho_100:hasMCBcode>
    </owl:NamedIndividual>
    


