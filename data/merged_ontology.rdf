    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Патологическое_влечение_к_азартным_играм -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Патологическое_влечение_к_азартным_играм">
        <rdf:type rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Расстройства_привычек_и_влечений"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Навязчивое_влечение_к_азартным_играм"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Ущерб_материальным_ценностям"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Ущерб_семейным_ценностям"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Частые_повторные_эпизоды_азартной_игры"/>
        <mob_psycho_100:hasDescription>Суть расстройства заключается в частых повторных эпизодах азартной игры, которые доминируют в жизни пациента в ущерб социальным, профессиональным, материальным и семейным ценностям и обязательствам.

Навязчивое влечение к азартным играм</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F63.0</mob_psycho_100:hasMCBcode>
        <psy_diseases_project:hasSuicideRisk rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</psy_diseases_project:hasSuicideRisk>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Педофилия -->

