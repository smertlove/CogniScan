    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Шизоидное_расстройство_личности -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Шизоидное_расстройство_личности">
        <rdf:type rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Специфические_расстройства_личности"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Отшельничество"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Самоанализ"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Склонность_к_фантазиям"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Слабость_привязанностей"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Слабость_социальных_и_других_контактов"/>
        <mob_psycho_100:hasDescription>Расстройство личности, характеризующееся слабостью привязанностей, социальных и других контактов, склонностью к фантазиям, отшельничеству и самоанализу. Имеет место ограниченная способность выражать чувства и испытывать удовольствие.</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F60.1</mob_psycho_100:hasMCBcode>
        <psy_diseases_project:hasDuration>Несколько лет</psy_diseases_project:hasDuration>
        <psy_diseases_project:hasSuicideRisk rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</psy_diseases_project:hasSuicideRisk>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Эгодистоническая_половая_ориентация -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Эгодистоническая_половая_ориентация">
        <rdf:type rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Психологические_и_поведенческие_расстройства,_связанные_с_половым_развитием_и_ориентацией"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Желание_изменить_половую_принадлежность"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Желание_сменить_сексуальную_ориентацию"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Расстройство_поведения"/>
        <mob_psycho_100:hasDescription>Половая принадлежность и сексуальное влечение (гетеросексуальное, гомосексуальное, бисексуальное или препубертатное) не вызывают сомнений, но индивид желает это изменить в связи с присоединившимися психологическими нарушениями и расстройствами поведения и может добиваться лечения для такого изменения.</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F66.1</mob_psycho_100:hasMCBcode>
    </owl:NamedIndividual>
    


