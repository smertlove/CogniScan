        <psy_diseases_project:SuffersFrom rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Постшизофреническая_депрессия"/>
        <psy_diseases_project:SuffersFrom rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Шизотипическое_расстройство"/>
        <mob_psycho_100:isOffensive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mob_psycho_100:isOffensive>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/alex/ontologies/2025/11/untitled-ontology-7#Шизофреник -->

