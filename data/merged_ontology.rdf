        <isSimilar rdf:resource="http://www.semanticweb.org/alex/ontologies/2025/11/untitled-ontology-7#Мания_без_психотических_симптомов"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/alex/ontologies/2025/11/untitled-ontology-7#Несвойственное_характеру_человека_поведение"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Невозможность_сосредоточиться"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Преувеличенная_самооценка"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Преувеличенное_выражение_эмоций"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Рассеянность"/>
        <mob_psycho_100:hasDescription>У пациента в данный момент имеются маниакальные явления без психотической симптоматики (как в подрубрике F30.1), и в прошлом отмечался, по крайней мере однократно, другой аффективный эпизод (гипоманиакальный, маниакальный, депрессивный или смешанного характера).</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F31.1</mob_psycho_100:hasMCBcode>
        <psy_diseases_project:requiresHospitalisation rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</psy_diseases_project:requiresHospitalisation>
    </owl:NamedIndividual>
    


