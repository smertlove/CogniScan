        <rdf:type rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Расстройства_поведения"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#агрессия"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#девиантное_поведение"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#чрезмерное_неповиновение"/>
        <mob_psycho_100:hasDescription>Расстройство поведения, заключающееся в диссоциальном и агрессивном поведении (а не только оппозиционное, дерзкое, разрывающее отношения поведение), при котором отклонение в поведении полностью или почти полностью ограничивается пределами дома и взаимоотношениями с членами семьи или ближайшими домочадцами.</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F91.0</mob_psycho_100:hasMCBcode>
        <psy_diseases_project:hasSuicideRisk rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</psy_diseases_project:hasSuicideRisk>
        <psy_diseases_project:requiresHospitalisation rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</psy_diseases_project:requiresHospitalisation>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Тревожное_расстройство_у_детей,_вызванное_разлукой -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Тревожное_расстройство_у_детей,_вызванное_разлукой">
        <rdf:type rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Эмоциональные_расстройства,_начало_которых_специфично_для_детского_возраста"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#расстройства_сна"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#чрезмерное_беспокойство"/>
        <mob_psycho_100:hasDescription>Его следует диагностировать, когда боязнь разлуки создает фокус тревожности и когда такая тревожность впервые возникает в течение первых лет жизни. От нормального беспокойства, вызванного разлукой, данное расстройство отличается статистически необычной степенью выраженности (тяжестью), включая ненормальную для этого возрастного периода продолжительность, и тем, что эта тревожность создает значительные проблемы социального функционирования.</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F93.0</mob_psycho_100:hasMCBcode>
        <psy_diseases_project:hasSuicideRisk rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</psy_diseases_project:hasSuicideRisk>
        <psy_diseases_project:requiresHospitalisation rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</psy_diseases_project:requiresHospitalisation>
    </owl:NamedIndividual>
    


