    </owl:Class>
    


    <!-- http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Шизотипическое_расстройство -->

    <owl:Class rdf:about="http://www.semanticweb.org/алена/ontologies/2025/8/psy_diseases_project#Шизотипическое_расстройство">
