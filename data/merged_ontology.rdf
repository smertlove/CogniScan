        <rdf:type rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Соматоформные_расстройства"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Психогенная_дисменорея"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Психогенная_дисфагия"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Психогенная_кривошея"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Психогенный_зуд"/>
        <mob_psycho_100:hasSymptom rdf:resource="http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Скрежетание_зубами"/>
        <mob_psycho_100:hasDescription>Какие-либо другие расстройства чувствительности, функций или поведения, возникающие не вследствие соматических нарушений. Расстройства, которые не опосредованы через вегетативную нервную систему, ограничены определенными системами или участками тела и имеют тесную временную связь с травмирующими событиями или проблемами.

Психогенная(ый):

дисменорея
дисфагия, включая &quot;глобус истерикус&quot; (globus hystericus)
зуд
кривошея
Скрежетание зубами</mob_psycho_100:hasDescription>
        <mob_psycho_100:hasMCBcode>F45.8</mob_psycho_100:hasMCBcode>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/eliza/ontologies/2025/9/mob_psycho_100#Другие_специфические_расстройства_личности -->

